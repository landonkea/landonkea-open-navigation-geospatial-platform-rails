<% content_for :title, @event.name %>
<%# MapLibre's own stylesheet -- only needed on this page, so it's %>
<%# pulled in here rather than loaded on every page in the app. %>
<% content_for :head do %>
  <%= stylesheet_link_tag "maplibre-gl" %>
<% end %>

<% if @event.status == "created" %>
  <%# The organizer hasn't hit "Start event" yet -- nothing to join or watch. %>
  <div class="max-w-md mx-auto mt-16 text-center">
    <h1 class="font-bold text-2xl mb-2"><%= @event.name %></h1>
    <p class="text-gray-500">This event hasn't started yet. Check back soon, or ask the organizer.</p>
  </div>

<% elsif @event.status == "ended" %>
  <%# It's over -- show a plain thanks screen instead of a dead map. %>
  <div class="max-w-md mx-auto mt-16 text-center">
    <h1 class="font-bold text-2xl mb-2"><%= @event.name %></h1>
    <p class="text-gray-500">This event has ended. Thanks for being part of it.</p>
  </div>

<% elsif @participant.nil? %>
  <%# Active event, brand-new visitor: ask how they want to join before %>
  <%# ever touching the browser's location permission (see MapsController#join %>
  <%# and app/models/participant.rb's docs on why this choice comes first). %>
  <div class="max-w-md mx-auto mt-10">
    <h1 class="font-bold text-2xl mb-1"><%= @event.name %></h1>
    <p class="text-gray-500 mb-6">How would you like to join?</p>

    <%= form_with url: event_join_path(@event), method: :post, class: "space-y-4" do |form| %>
      <label for="mode_rider" class="block border border-gray-300 rounded-lg p-4 cursor-pointer hover:border-orange-500">
        <input type="radio" name="mode" id="mode_rider" value="rider" checked class="mr-2">
        <span class="font-medium">I'm sharing my location</span>
        <p class="text-sm text-gray-500 mt-1 ml-6">Your browser will ask for location permission. Your dot appears live on the map for everyone else here.</p>
      </label>
      <label for="mode_spectator" class="block border border-gray-300 rounded-lg p-4 cursor-pointer hover:border-orange-500">
        <input type="radio" name="mode" id="mode_spectator" value="spectator" class="mr-2">
        <span class="font-medium">Just watching</span>
        <p class="text-sm text-gray-500 mt-1 ml-6">See everyone else's live position. Your own location is never requested or shared.</p>
      </label>

      <div>
        <%= form.label :tag, "Optional label (e.g. \"marshal\")", class: "block text-sm font-medium mb-1" %>
        <%= form.text_field :tag, class: "block shadow-sm rounded-md border border-gray-300 px-3 py-2 w-full" %>
      </div>

      <%= form.submit "Join event", class: "w-full rounded-md px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-medium cursor-pointer" %>
    <% end %>
  </div>

<% else %>
  <%# Active event, a person we already recognize (via their signed cookie, %>
  <%# see ParticipantIdentity) -- show the real live map. %>
  <div class="max-w-5xl mx-auto"
       data-controller="live-map"
       data-live-map-event-slug-value="<%= @event.slug %>"
       data-live-map-participant-id-value="<%= @participant.id %>"
       data-live-map-is-spectator-value="<%= @participant.is_spectator? %>"
       data-live-map-positions-url-value="<%= event_positions_path(@event) %>"
       data-live-map-initial-participants-value="<%= @event.participants.map(&:to_map_payload).to_json %>">
    <div class="flex items-center justify-between mb-3">
      <h1 class="font-bold text-2xl"><%= @event.name %></h1>
      <%= button_to "Leave", event_leave_path(@event), method: :delete,
            class: "text-sm text-gray-500 hover:text-gray-700 underline bg-transparent border-none p-0 cursor-pointer" %>
    </div>

    <p data-live-map-target="status" class="text-xs text-gray-400 mb-2">Connecting...</p>

    <div id="map" data-live-map-target="map" class="w-full h-[60vh] rounded-lg border border-gray-200"></div>

    <h2 class="font-semibold text-lg mt-6 mb-3">Who's here (<%= @event.participants.count %>)</h2>
    <%= turbo_stream_from @event, :roster %>
    <%= render "events/roster", participants: @event.participants.order(created_at: :desc) %>
  </div>
<% end %>
