<% content_for :title, "Your events" %>

<div class="max-w-3xl mx-auto">
  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-700 font-medium rounded-lg"><%= notice %></p>
  <% end %>

  <div class="flex items-center justify-between mb-6">
    <h1 class="font-bold text-3xl">Events</h1>
    <%= link_to "New event", new_event_path, class: "rounded-md px-4 py-2 bg-orange-600 hover:bg-orange-500 text-white font-medium" %>
  </div>

  <% if @events.empty? %>
    <p class="text-gray-500">No events yet. Create the first one.</p>
  <% else %>
    <ul class="divide-y divide-gray-200 border border-gray-200 rounded-lg overflow-hidden">
      <% @events.each do |event| %>
        <li class="p-4 flex items-center justify-between">
          <div>
            <%= link_to event.name, event_path(event), class: "font-medium hover:underline" %>
            <span class="ml-2 text-xs uppercase tracking-wide px-2 py-0.5 rounded-full
              <%= event.status == "active" ? "bg-green-100 text-green-700" : event.status == "ended" ? "bg-gray-100 text-gray-500" : "bg-yellow-100 text-yellow-700" %>">
              <%= event.status %>
            </span>
            <div class="text-sm text-gray-500">Join code: <%= event.slug %></div>
          </div>
          <div class="text-sm text-gray-400"><%= event.created_at.strftime("%b %-d, %Y") %></div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
